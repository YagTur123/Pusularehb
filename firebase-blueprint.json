{
  "entities": {
    "counselor": {
      "title": "Counselor Profile",
      "description": "Counselor profile, credentials, and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "school": { "type": "string" },
        "phone": { "type": "string" },
        "created_at": { "type": "string" },
        "avatar_color": { "type": "string" },
        "kvkk_accepted": { "type": "boolean" },
        "kvkk_accepted_at": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "student": {
      "title": "Student Record",
      "description": "Student CRM record with status flags and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "full_name": { "type": "string" },
        "class_grade": { "type": "string" },
        "phone": { "type": "string" },
        "last_meeting_date": { "type": "string" },
        "status_flags": { "type": "array" },
        "target_goal": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "full_name"]
    },
    "session": {
      "title": "Guidance Session",
      "description": "Individual or group guidance session entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "time_slot": { "type": "string" },
        "student_id": { "type": "string" },
        "topic": { "type": "string" },
        "action_items": { "type": "string" },
        "tags": { "type": "array" },
        "status": { "type": "string" },
        "created_at": { "type": "string" },
        "next_followup_date": { "type": "string" },
        "is_priority": { "type": "boolean" },
        "is_break": { "type": "boolean" },
        "break_title": { "type": "string" },
        "break_duration": { "type": "number" },
        "feedback": { "type": "object" }
      },
      "required": ["id", "date", "time_slot", "status"]
    },
    "setting": {
      "title": "Counselor Settings",
      "description": "Configuration settings like schedule layout or KVKK agreements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionDuration": { "type": "number" },
        "breakDuration": { "type": "number" },
        "startTime": { "type": "string" },
        "sessionCount": { "type": "number" },
        "includeLunchBreak": { "type": "boolean" },
        "lunchBreakAfter": { "type": "number" },
        "lunchBreakDuration": { "type": "number" },
        "updated_at": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/counselors/{uid}": {
      "schema": "counselor",
      "description": "Root counselor profile and preference document"
    },
    "/counselors/{uid}/students/{studentId}": {
      "schema": "student",
      "description": "Subcollection of individual student CRM documents"
    },
    "/counselors/{uid}/sessions/{sessionId}": {
      "schema": "session",
      "description": "Subcollection of guidance and counseling sessions"
    },
    "/counselors/{uid}/settings/{settingId}": {
      "schema": "setting",
      "description": "Subcollection of counselor settings such as schedule and KVKK consent"
    }
  }
}
