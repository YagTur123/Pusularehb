rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to verify user ownership based on authenticated Firebase UID
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Validation for Student documents
    function validStudent(data) {
      return data.keys().hasAll(['id', 'full_name', 'class_grade', 'created_at'])
        && data.keys().hasOnly(['id', 'full_name', 'class_grade', 'phone', 'last_meeting_date', 'status_flags', 'target_goal', 'notes', 'created_at'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 150
        && data.class_grade is string && data.class_grade.size() <= 50
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('last_meeting_date' in data) || data.last_meeting_date == null || (data.last_meeting_date is string && data.last_meeting_date.size() <= 50))
        && (!('status_flags' in data) || (data.status_flags is list && data.status_flags.size() <= 30))
        && (!('target_goal' in data) || (data.target_goal is string && data.target_goal.size() <= 250))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000))
        && data.created_at is string && data.created_at.size() <= 50;
    }

    // Validation for Session documents
    function validSession(data) {
      return data.keys().hasAll(['id', 'date', 'time_slot', 'status', 'created_at'])
        && data.keys().hasOnly(['id', 'date', 'time_slot', 'student_id', 'topic', 'action_items', 'tags', 'status', 'created_at', 'next_followup_date', 'is_priority', 'is_break', 'break_title', 'break_duration', 'feedback', 'whatsapp_sent', 'whatsapp_sent_at', 'is_in_progress'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.date is string && data.date.size() <= 20
        && data.time_slot is string && data.time_slot.size() <= 30
        && (!('student_id' in data) || data.student_id == null || (data.student_id is string && data.student_id.size() <= 100))
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 300))
        && (!('action_items' in data) || (data.action_items is string && data.action_items.size() <= 1500))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30))
        && data.status is string && data.status.size() <= 30
        && data.created_at is string && data.created_at.size() <= 50
        && (!('next_followup_date' in data) || (data.next_followup_date is string && data.next_followup_date.size() <= 50))
        && (!('break_title' in data) || (data.break_title is string && data.break_title.size() <= 150))
        && (!('whatsapp_sent_at' in data) || (data.whatsapp_sent_at is string && data.whatsapp_sent_at.size() <= 50));
    }

    // Validation for Counselor Setting documents
    function validSetting(data) {
      return data.keys().hasOnly(['id', 'sessionDuration', 'breakDuration', 'startTime', 'sessionCount', 'includeLunchBreak', 'lunchBreakAfter', 'lunchBreakDuration', 'updated_at', 'accepted', 'accepted_at', 'version'])
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 20))
        && (!('updated_at' in data) || (data.updated_at is string && data.updated_at.size() <= 50))
        && (!('accepted_at' in data) || (data.accepted_at is string && data.accepted_at.size() <= 50))
        && (!('version' in data) || (data.version is string && data.version.size() <= 20));
    }

    // Counselor root document (profile, metadata, preferences)
    match /counselors/{userId} {
      allow read, write, delete: if isOwner(userId);

      // Subcollection: Students (KVKK protected minors data)
      match /students/{studentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validStudent(request.resource.data);
      }

      // Subcollection: Sessions & Meetings
      match /sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSession(request.resource.data);
      }

      // Subcollection: Counselor Settings (Schedule configuration, KVKK consent)
      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSetting(request.resource.data);
      }
    }

    // Counselor profiles legacy - only delete allowed
    match /counselor_profiles/{userId} {
      allow delete: if isOwner(userId);
      allow read, create, update: if false;
    }

    // Counselor data legacy - only delete allowed
    match /counselor_data/{userId} {
      allow delete: if isOwner(userId);
      allow read, create, update: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
